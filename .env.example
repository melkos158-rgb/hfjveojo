# ORVIONIS environment variables — every name the code reads (src/lib/env.ts), placeholders only.
# LOCAL: copy to .env.local (git-ignored). PRODUCTION: Railway → service hfjveojo → Variables.
# NEVER commit real values. Full audit: docs/REQUIRED_SERVICES_AND_KEYS.md · canonical list: docs/ENVIRONMENT_VARIABLES.md

# ---- App ----
APP_ENV=development                      # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000  # base URL: links, Google redirect URI, Stripe success/cancel URLs
NEXT_PUBLIC_BRAND_NAME=ORVIONIS
ADMIN_EMAILS=you@example.com             # comma-separated; these accounts get role ADMIN on login
SESSION_TTL_DAYS=30
LOG_LEVEL=info                           # debug | info | warn | error

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orvionis?schema=public
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}?schema=orvionis

# ---- App secrets (generate: openssl rand -base64 32; different value per environment) ----
AUTH_SECRET=                             # ≥32 chars: session JWT + Google sign-in state
SIGNING_SECRET=                          # ≥16 chars: order access links, signed file URLs
CRON_SECRET=                             # bearer token for /api/internal/* (external scheduler only)

# ---- Stripe (server-side only; hosted Checkout → no publishable key, no Price IDs) ----
STRIPE_SECRET_KEY=                       # sk_test_… / rk_test_… (sandbox) — live key in V1
STRIPE_WEBHOOK_SECRET=                   # whsec_… of the destination <APP_URL>/api/stripe/webhook
STRIPE_CURRENCY=usd

# ---- AI ----
AI_PROVIDER=openai                       # openai | anthropic | mock (mock = free, deterministic, dev/test)
OPENAI_API_KEY=                          # platform.openai.com → project ORVIONIS → API keys
ANTHROPIC_API_KEY=                       # FUTURE (V2): only with AI_PROVIDER=anthropic
AI_MODEL_CHEAP=gpt-4.1-mini
AI_MODEL_STANDARD=gpt-4.1
AI_MODEL_BEST=gpt-4.1
AI_DAILY_BUDGET_CENTS=500                # hard stop for AI spend per day (5.00 USD)
AI_MAX_COST_PER_ORDER_CENTS=100          # hard stop per order
AI_PRICE_TABLE_JSON=                     # optional override: {"gpt-4.1-mini":{"in":0.4,"out":1.6}} USD per 1M tokens

# ---- Email (Resend HTTP API). Dev: EMAIL_PROVIDER=console → emails go to the terminal, magic link shown on /login ----
EMAIL_PROVIDER=console                   # resend | console
RESEND_API_KEY=                          # resend.com/api-keys — "Sending access"; domain orvionis.com must be verified (DNS)
EMAIL_FROM="ORVIONIS <hello@orvionis.com>"
EMAIL_REPLY_TO=hello@orvionis.com

# ---- Google sign-in (optional; button appears on /login when both are set) ----
# Google Cloud → Credentials → OAuth client (Web). Authorized redirect URIs:
#   https://orvionis.com/api/auth/google/callback   and   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage ----
STORAGE_BACKEND=db                       # db (files in Postgres, fine for MVP) | s3 (Cloudflare R2 / S3, V2)
S3_ENDPOINT=                             # https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILE_RETENTION_DAYS_OUTPUT=90
FILE_RETENTION_DAYS_INPUT=30

# ---- Jobs (Postgres-backed queue; no Redis) ----
JOBS_INLINE=true                         # run new jobs immediately in the web process (dev, and production without a worker service)
EMBEDDED_WORKER=true                     # job loop inside the web process: retries, hourly maintenance, daily CEO report
EMBEDDED_WORKER_CONCURRENCY=1
EMBEDDED_WORKER_POLL_MS=10000
WORKER_CONCURRENCY=2                     # dedicated worker (npm run worker) only — V3
WORKER_POLL_MS=2000
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30 # Railway setting (V1): let in-flight jobs finish on deploy; default 3s

# ---- SEO verification (public, optional; DNS TXT verification needs no variable) ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=    # Search Console → HTML tag method → content="…"
NEXT_PUBLIC_BING_SITE_VERIFICATION=      # Bing Webmaster Tools → meta tag → content="…"

# ---- Observability ----
SENTRY_DSN=                              # FUTURE (V1): reserved; SDK not installed yet

# ---- FUTURE (not read by the code yet; listed so the names are settled) ----
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=        # Cloudflare Turnstile widget (V2, only if spam appears)
# TURNSTILE_SECRET_KEY=
# RESEND_WEBHOOK_SECRET=                 # bounce/complaint webhook (V2)
