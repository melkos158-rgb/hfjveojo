# ORVIONIS environment variables
# LOCAL: copy to .env.local (git-ignored). PRODUCTION: set in Railway → Variables. NEVER commit real values.

# ---- App ----
APP_ENV=development                      # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=ORVIONIS
ADMIN_EMAILS=you@example.com             # comma-separated; these accounts get role ADMIN on login

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orvionis?schema=public

# ---- Auth ----
AUTH_SECRET=change-me-32-bytes-minimum-random-string   # openssl rand -base64 32
SESSION_TTL_DAYS=30
SIGNING_SECRET=change-me-another-random-string          # signs order access links & file URLs

# ---- Stripe (server-side only; publishable key is not needed for hosted Checkout) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# ---- AI providers ----
AI_PROVIDER=openai                       # openai | anthropic | mock
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=                       # optional fallback provider
AI_MODEL_CHEAP=gpt-4.1-mini
AI_MODEL_STANDARD=gpt-4.1
AI_MODEL_BEST=gpt-4.1
AI_DAILY_BUDGET_CENTS=500                # hard stop for AI spend per day (5.00 USD)
AI_MAX_COST_PER_ORDER_CENTS=100          # hard stop per order
AI_PRICE_TABLE_JSON=                     # optional override: {"gpt-4.1-mini":{"in":0.4,"out":1.6}} USD per 1M tokens

# ---- Email (Resend HTTP API; leave key empty in dev → emails are logged to console) ----
EMAIL_PROVIDER=resend                    # resend | console
RESEND_API_KEY=
EMAIL_FROM="ORVIONIS <hello@orvionis.com>"
EMAIL_REPLY_TO=hello@orvionis.com

# ---- Storage ----
STORAGE_BACKEND=db                       # db (small files in Postgres) | s3 (Cloudflare R2 / S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILE_RETENTION_DAYS_OUTPUT=90
FILE_RETENTION_DAYS_INPUT=30

# ---- Jobs ----
JOBS_INLINE=false                        # true = run jobs immediately in the web process (dev only, no worker needed)
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
CRON_SECRET=change-me                    # protects /api/internal/* endpoints (daily report, job kick)

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info
